{
  "name": "dsh-super-nexusx",
  "version": "0.11.10",
  "description": "DSH Super Nexusx（DSH 超级工作台）：集成 Liquid Glass 主题、会话目录、陪伴宠物与上下文系统的 DSH 扩展",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "locale",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "assets/pets/README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "preview": "node scripts/preview-server.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/test-ui.mjs",
    "test:installed": "node scripts/check-installed-runtime.mjs && node scripts/check-client-runtime.mjs",
    "pack:plugin": "node scripts/pack.mjs",
    "build:preview": "npm run build && node scripts/build-preview.mjs",
    "check": "npm run lint && node scripts/check-project.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test:bundle": "node scripts/check-bundle-runtime.mjs",
    "release:build": "node scripts/release.mjs",
    "test:release": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@eslint/js": "^10.0.1",
    "@juggle/resize-observer": "^3.4.0",
    "esbuild": "0.25.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "author": "anjon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biek12/dsh-super-nexusx.git"
  },
  "homepage": "https://github.com/biek12/dsh-super-nexusx#readme",
  "bugs": {
    "url": "https://github.com/biek12/dsh-super-nexusx/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "workspace",
    "liquid-glass",
    "desktop-pet"
  ]
}
